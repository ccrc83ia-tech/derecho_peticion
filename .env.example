GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# --- Session ---
# Clave secreta para firmar cookies de sesión (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga
SESSION_TTL_SECONDS=28800

# --- Database ---
# PostgreSQL (production) — when set, SQLite is ignored
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/legal_engine

# SQLite (local development fallback — used only when DATABASE_URL is not set)
DB_PATH=legal_engine.db

TENANT_DATASOURCE=tenants.json
TEMPLATES_DATASOURCE=templates.json
ENTITIES_DATASOURCE=entities.json

# --- RAG ---
CHROMA_DIR=chroma_db
RAG_CHUNK_SIZE=1500
RAG_CHUNK_OVERLAP=200

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- API ---
API_HOST=localhost
API_PORT=8000
CORS_ORIGINS=http://localhost:8501
RATE_LIMIT_RPM=30
ENABLE_DOCS=true
API_TIMEOUT_GENERATE=120
